for hero in heroes:
	hero["result"] = {
		"fight-2gor": { },
		"fight-3gor": { },
		"torch": { },
	}

	md = MultiDice(dice = hero["dice"])
	for gor in [ 3, 2 ]:
		initial_state = FrozenDict({
			"remaining_moves": hero["moves"] + 1,
			"remaining_dice": hero["dice_count"],
			"remaining_gors": gor,
		})
		mmb = MarkovMatrixBuilder(multi_dice = md)
		mmatrix = mmb.compute_matrix(initial_state = initial_state)
		mmb.dump_graphviz(initial_state = initial_state, filename = f"hero_{hero['name_short']}_{gor}gor.dot")

		for move_count in range(1, hero["moves"] + 2):
			win_probability = 0
			for (outcome, probability) in mmatrix.steps(initial_state, move_count):
				if outcome["remaining_gors"] == 0:
					win_probability += probability
			hero["result"][f"fight-{gor}gor"][move_count] = win_probability

	torch_probability = 0
	for (outcome, probability) in md.outcomes(dice_count = hero["dice_count"]).items():
		if outcome.get("torch", 0) > 0:
			torch_probability += probability

	for move_count in range(1, hero["moves"] + 2):
		p = 1 - ((1 - torch_probability) ** move_count)
		hero["result"]["torch"][move_count] = p


